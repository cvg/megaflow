{
    "name": "C-Tartan-T-mf",
    "dataset": "things",
    "val_datasets": ["sintel-clean", "sintel-final", "kitti", "things-clean", "things-final"],
    "monitor": null,

    "patch_embed": "dinov2_vitl14_reg",
    "patch_size": 14,
    "feature_channels": 128,
    "fix_width": false,
    "fuse_cnn": true,
    "freeze_backbone": false,
    "upsample_factor": 4,
    "iters": 4,
    "random_frame": true,
    "use_self_attn_propagation": false,
    "use_temp_attn": true,

    "image_size": [432, 960],
    "max_frames": 6,
    "bidirectional": false,
    "effective_batch_size": 128,
    "accumulate_grad_batches": 1,
    "num_workers": 16,
    "epsilon": 1e-8,
    "lr": 2e-4,
    "wdecay": 1e-4,
    "dropout": 0,
    "clip": 1.0,
    "gamma": 0.9,
    "num_steps": 15000,
    "val_steps": 1500,
    "save_steps": 3000,
    "freeze_bn": false,
    
    "restore_ckpt": "./checkpoints/C-Tartan-T-2f.ckpt",
    "coarse_config": null
}
